VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional — leave unset to auto-detect (uses whatever host the page was
# loaded from, e.g. localhost or your LAN IP, on port 4000). Set explicitly
# only for a real deployment where the backend lives on a different domain.
VITE_API_BASE_URL=
VITE_VAPID_PUBLIC_KEY=
