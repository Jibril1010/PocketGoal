PORT=4000
# Comma-separated list — add your computer's LAN IP here to test on your
# phone, e.g. http://localhost:5173,http://192.168.1.23:5173
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Free tier available at https://aistudio.google.com/apikey — no credit card required
GEMINI_API_KEY=...

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com
